# ─── Server ───────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Supabase PostgreSQL) ───────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:123456@db.duazbhqkllmboqrzfspx.supabase.co:5432/postgres

# ─── JWT ──────────────────────────────────────────────────────────
# Use a long random string (e.g. openssl rand -hex 64)
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET
# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── GitHub OAuth (passport-github2) ─────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# Must match what you registered in the GitHub OAuth app settings
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ─── Google OAuth (passport-google-oauth20) ───────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ─── Anthropic (Claude AI) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# ─── Client ───────────────────────────────────────────────────────
# URL of the frontend — used for CORS and OAuth redirect
CLIENT_URL=http://localhost:5173
